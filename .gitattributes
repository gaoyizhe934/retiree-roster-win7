* text=auto
*.md text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.docx binary
*.xlsx binary

# Vendored third-party sources keep upstream bytes and are exempt from the
# project whitespace gate (the vendored file fingerprint is recorded instead).
third_party/sqlite/** text eol=lf whitespace=-trailing-space
